{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM Task Plan",
  "type": "object",
  "required": [
    "contest",
    "question_count",
    "subquestions",
    "global_assumptions",
    "risk_points"
  ],
  "properties": {
    "contest": {
      "type": "string"
    },
    "problem_id": {
      "type": "string"
    },
    "benchmark_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "use"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "rubric_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "target"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "subquestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "task_type",
          "required_output",
          "input_data",
          "decision_object",
          "constraints",
          "validation",
          "figures_needed",
          "tables_needed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "task_type": {
            "type": "string"
          },
          "required_output": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_object": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "figures_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tables_needed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "baseline_route": {
            "type": "string"
          },
          "primary_route": {
            "type": "string"
          },
          "fallback_route": {
            "type": "string"
          },
          "minimum_validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "benchmark_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rubric_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selling_points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim",
                "evidence"
              ],
              "properties": {
                "claim": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "figure_or_table": {
                  "type": "string"
                },
                "validation": {
                  "type": "string"
                }
              }
            }
          },
          "revision_status": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "next_action": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "global_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_status": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        }
      }
    }
  }
}
